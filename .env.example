# Copy to .env (git-ignored). Variable names only, no secrets.
# Identification required by MET API terms: app name/version and a team contact,
# e.g. northlink-hackathon/0.1 (team contact: you@example.org)
# Live MET refresh is disabled until this is set. Read by northlink/connectors/met.py.
NORTHLINK_MET_USER_AGENT=
# Optional: alternate database path
NORTHLINK_DB=
